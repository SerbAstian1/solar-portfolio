    "three": "^0.169.0"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.4.2",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^7.0.2",
    "vite": "^5.3.1",
    "vitest": "^4.1.11"
  }
}
